<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NoesisToolkit.Testing</RootNamespace>
    <PackageId>NoesisToolkit.Testing</PackageId>
    <Description>Renderless harnesses for NoesisGUI. ControlCollectability proves controls are collectable: every constructible control is added to a live view, removed, and reported if the heap still holds it, catching the handler and command leaks NTK2101 and NTK2102 cannot see. XamlParity proves the XAML compiler builds what the Noesis parser builds for every document of a generated registry.</Description>
    <PackageTags>$(PackageTags);testing;memory-leak;xaml</PackageTags>
    <!-- Noesis.GUI ships win10-* RIDs the modern SDK no longer probes; nothing here consumes them. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Noesis.GUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NoesisToolkit.Mvvm/NoesisToolkit.Mvvm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/NoesisSlots.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
