<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>NoesisToolkit.Testing</RootNamespace>
    <PackageId>NoesisToolkit.Testing</PackageId>
    <Description>A renderless harness that proves NoesisGUI controls are collectable: every constructible control is added to a live view, removed, and reported if the heap still holds it. Catches the handler and command leaks NTK2101 and NTK2102 cannot see, including anything markup wired.</Description>
    <PackageTags>$(PackageTags);testing;memory-leak</PackageTags>
    <!-- Noesis.GUI ships win10-* RIDs the modern SDK no longer probes; nothing here consumes them. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Noesis.GUI" />
  </ItemGroup>
</Project>
