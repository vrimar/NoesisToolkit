<Project>
  <PropertyGroup>
    <NoesisXamlExtensions Condition="'$(NoesisXamlExtensions)' == ''">.xaml</NoesisXamlExtensions>
    <EnableDefaultNoesisXamlItems Condition="'$(EnableDefaultNoesisXamlItems)' == ''"
      >true</EnableDefaultNoesisXamlItems>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="NoesisXamlPackPrefix" />
    <CompilerVisibleProperty Include="NoesisXamlExtensions" />
    <CompilerVisibleProperty Include="NoesisXamlNamespaces" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="PublishAot" />
    <CompilerVisibleProperty Include="PublishTrimmed" />
    <CompilerVisibleProperty Include="IsTrimmable" />
    <CompilerVisibleProperty Include="IsAotCompatible" />
    <CompilerVisibleProperty Include="EnableTrimAnalyzer" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Link" />
  </ItemGroup>
</Project>
