<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The audit feed is transient; an advisory published mid-build must not fail it. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- Roslyn requires it of an analyzer assembly, and the Mvvm package packs the generator from
         a path built out of it, so both read the one value. -->
    <NoesisAnalyzerTargetFramework>netstandard2.0</NoesisAnalyzerTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- No version in tree: the release workflow passes -p:Version= from the tag. -->
    <Authors>Vasil Rimar</Authors>
    <Product>NoesisToolkit</Product>
    <Copyright>Copyright (c) Vasil Rimar</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vrimar/NoesisToolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vrimar/NoesisToolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>noesis;noesisgui;xaml;roslyn;source-generator</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)assets/icon.png"
      Pack="true"
      PackagePath="/"
      Visible="false"
      Condition="Exists('$(MSBuildThisFileDirectory)assets/icon.png')"
    />
  </ItemGroup>
</Project>
