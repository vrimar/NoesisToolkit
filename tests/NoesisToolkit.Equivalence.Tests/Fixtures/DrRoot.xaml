<UserControl
  x:Class="NoesisToolkit.Equivalence.Tests.DrRootFixture"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="t:DrModel"
  Width="400"
  Height="300"
>
  <StackPanel>
    <t:DrHost x:Name="Host">
      <t:DrHost.InputBindings>
        <KeyBinding Key="F2" CommandParameter="{Binding Name}" />
      </t:DrHost.InputBindings>
      <b:Interaction.Behaviors>
        <t:DrBehavior Payload="{Binding Name}" />
      </b:Interaction.Behaviors>
      <b:Interaction.Triggers>
        <t:DrTrigger>
          <t:DrAction Parameter="{Binding Name}" />
        </t:DrTrigger>
      </b:Interaction.Triggers>
    </t:DrHost>
  </StackPanel>
</UserControl>
