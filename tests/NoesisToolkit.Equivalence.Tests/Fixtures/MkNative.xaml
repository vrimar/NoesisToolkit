<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
>
  <Style x:Key="Mk.NativeSetters" TargetType="TextBlock">
    <Setter Property="noesis:Text.StrokeThickness" Value="2" />
    <Setter Property="noesis:Text.Stroke" Value="Red" />
  </Style>
  <TextBlock x:Key="Mk.NativeTriggered" noesis:Text.StrokeThickness="2">
    <TextBlock.Style>
      <Style TargetType="TextBlock">
        <Style.Triggers>
          <Trigger Property="noesis:Text.StrokeThickness" Value="2">
            <Setter Property="Tag" Value="trigger" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="noesis:Text.StrokeThickness" Value="2" />
            </MultiTrigger.Conditions>
            <Setter Property="Width" Value="33" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
    </TextBlock.Style>
  </TextBlock>
  <TextBlock x:Key="Mk.NativeElement">
    <noesis:Text.Stroke>
      <SolidColorBrush Color="#FF123456" />
    </noesis:Text.Stroke>
  </TextBlock>
</ResourceDictionary>
