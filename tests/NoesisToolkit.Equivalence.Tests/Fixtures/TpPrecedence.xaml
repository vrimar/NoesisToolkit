<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <t:TpFirst x:Key="TpFirst" />

  <Style x:Key="NativeTrigger" TargetType="{x:Type t:TpHost}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type t:TpHost}">
          <StackPanel>
            <t:TpPart x:Name="Part" Ratio="{TemplateBinding Ratio}" Height="5" />
            <t:TpPart x:Name="Free" Ratio="{TemplateBinding Ratio}" Height="5" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Mode" Value="1">
              <Setter Property="Tag" Value="on" />
              <Setter TargetName="Part" Property="Ratio" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="QualifiedTrigger" TargetType="{x:Type t:TpHost}">
    <StackPanel>
      <t:TpPart x:Name="Part" Ratio="{TemplateBinding Ratio}" Height="5" />
      <t:TpPart x:Name="Free" Ratio="{TemplateBinding Ratio}" Height="5" />
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Mode" Value="1">
        <Setter TargetName="Part" Property="t:TpPart.Ratio" Value="0.75" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="CompiledTrigger" TargetType="{x:Type t:TpHost}">
    <StackPanel>
      <t:TpPart
        x:Name="Part"
        Ratio="{Binding Ratio, RelativeSource={RelativeSource TemplatedParent}}"
        Height="5"
      />
      <t:TpPart
        x:Name="Free"
        Ratio="{Binding Ratio, RelativeSource={RelativeSource TemplatedParent}}"
        Height="5"
      />
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Mode" Value="1">
        <Setter TargetName="Part" Property="Ratio" Value="0.75" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MultiBound" TargetType="{x:Type t:TpHost}">
    <StackPanel>
      <t:TpPart x:Name="Part" Height="5">
        <t:TpPart.Ratio>
          <MultiBinding Converter="{StaticResource TpFirst}">
            <Binding Path="Ratio" RelativeSource="{RelativeSource TemplatedParent}" />
          </MultiBinding>
        </t:TpPart.Ratio>
      </t:TpPart>
      <t:TpPart x:Name="Free" Height="5">
        <t:TpPart.Ratio>
          <MultiBinding Converter="{StaticResource TpFirst}">
            <Binding Path="Ratio" RelativeSource="{RelativeSource TemplatedParent}" />
          </MultiBinding>
        </t:TpPart.Ratio>
      </t:TpPart>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Mode" Value="1">
        <Setter TargetName="Part" Property="Ratio" Value="0.75" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="StyleUnderNativeTrigger" TargetType="{x:Type t:TpHost}">
    <StackPanel>
      <Border x:Name="Part" Height="5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding Mode, RelativeSource={RelativeSource TemplatedParent}}"
                Value="2"
              >
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
      <Border x:Name="Free" Height="5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding Mode, RelativeSource={RelativeSource TemplatedParent}}"
                Value="2"
              >
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Level" Value="1">
        <Setter TargetName="Part" Property="UIElement.Opacity" Value="0.25" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="StyleUnderCompiledTrigger" TargetType="{x:Type t:TpHost}">
    <StackPanel>
      <Border x:Name="Part" Height="5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding Mode, RelativeSource={RelativeSource TemplatedParent}}"
                Value="2"
              >
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
      <Border x:Name="Free" Height="5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding Mode, RelativeSource={RelativeSource TemplatedParent}}"
                Value="2"
              >
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Level" Value="1">
        <Setter TargetName="Part" Property="Opacity" Value="0.25" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <DataTemplate x:Key="LocalValues" ntk:DataType="t:TpItem">
    <StackPanel>
      <TextBlock x:Name="Aliased" TextElement.Foreground="Red" Text="a">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Foreground" Value="Green" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="Unaliased" Text="b">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Foreground" Value="Green" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <ContentControl x:Name="Texted">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Content" Value="triggered" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
        hello
      </ContentControl>
      <ContentControl x:Name="Elemented">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Content" Value="triggered" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
        <TextBlock Text="child" />
      </ContentControl>
      <ContentControl x:Name="Empty">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Content" Value="triggered" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
      <Border x:Name="Qualified" Height="5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Index}" Value="1">
                <Setter Property="UIElement.Opacity" Value="0.25" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
      <Border x:Name="Lone" Height="5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Flag}" Value="True">
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
