<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml">
      <SolidColorBrush x:Key="Res.MergedInline" Color="#FF0000FF" />
    </ResourceDictionary>
  </ResourceDictionary.MergedDictionaries>

  <Border x:Key="Res.SourceHost">
    <Border.Resources>
      <ResourceDictionary Source="Palette.xaml">
        <SolidColorBrush x:Key="Res.Inline" Color="#FF00FF00" />
        <SolidColorBrush x:Key="Accent" Color="#FFFF0000" />
        <Border x:Key="Res.UsesAccent" Background="{StaticResource Accent}" />
      </ResourceDictionary>
    </Border.Resources>
  </Border>
</ResourceDictionary>
