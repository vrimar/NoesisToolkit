<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <ControlTemplate x:Key="TriggeredTemplate" TargetType="{x:Type Button}">
    <Border x:Name="Bg" Background="{StaticResource Muted}" BorderThickness="1">
      <ContentPresenter x:Name="Body" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}" />
        <Setter TargetName="Body" Property="Opacity" Value="0.75" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="SizedTemplate" TargetType="{x:Type Button}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="Side" Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="Top" Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <ContentPresenter Grid.Column="1" Grid.Row="1" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Side" Property="Width" Value="0" />
        <Setter TargetName="Top" Property="Height" Value="0" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="EmptiedTemplate" TargetType="{x:Type TextBox}">
    <Border x:Name="Frame">
      <ScrollViewer x:Name="PART_ContentHost" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
      </Trigger>
      <Trigger Property="Text" Value="">
        <Setter TargetName="Frame" Property="Opacity" Value="0.25" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Text" Value="{x:Null}" />
          <Condition Property="IsEnabled" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Frame" Property="Opacity" Value="0.1" />
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Unworded" TargetType="{x:Type TextBlock}">
    <Setter Property="Text" Value="{x:Null}" />
  </Style>

  <Style x:Key="Triggered" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderThickness" Value="2" />
      </Trigger>
      <DataTrigger Binding="{Binding Selected}" Value="True">
        <Setter Property="Opacity" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Bound" TargetType="{x:Type TextBlock}">
    <Setter Property="Text" Value="{Binding Label}" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
</ResourceDictionary>
