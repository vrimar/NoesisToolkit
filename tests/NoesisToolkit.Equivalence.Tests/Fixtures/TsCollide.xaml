<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ControlTemplate x:Key="Collide" TargetType="ContentControl">
    <StackPanel>
      <Border x:Name="Part" Background="Red" Width="50" Height="20" />
      <ContentPresenter>
        <ContentPresenter.ContentTemplate>
          <DataTemplate>
            <Button x:Name="Part" />
          </DataTemplate>
        </ContentPresenter.ContentTemplate>
      </ContentPresenter>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Tag" Value="on">
        <Setter TargetName="Part" Property="Padding" Value="7" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
