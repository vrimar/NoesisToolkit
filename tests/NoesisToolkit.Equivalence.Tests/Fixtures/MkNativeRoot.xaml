<UserControl
  x:Class="NoesisToolkit.Equivalence.Tests.MkNativeRoot"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
>
  <UserControl.Resources>
    <Style x:Key="Mk.AppConverted" TargetType="TextBlock">
      <Setter Property="Text" Value="{Binding Name, Converter={StaticResource Upper}}" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock x:Name="Converted" Style="{StaticResource Mk.AppConverted}" />
    <TextBlock x:Name="Stroked" Text="s" noesis:Text.Stroke="{StaticResource Accent}" />
    <TextBlock x:Name="WholeStroked" Text="w" noesis:Text.Stroke="{StaticResource Accent}">
      <TextBlock.Foreground>
        <SolidColorBrush Color="{DynamicResource Mk.LiveColor}" />
      </TextBlock.Foreground>
    </TextBlock>
  </StackPanel>
</UserControl>
