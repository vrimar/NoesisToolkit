<UserControl
  x:Class="NoesisToolkit.Equivalence.Tests.ResLaterRoot"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <StackPanel>
    <StackPanel x:Name="EndHost">
      <Border x:Name="EndBefore" Background="{StaticResource Res.LaterRoot}" />
      <StackPanel.Resources>
        <SolidColorBrush x:Key="Res.LaterRoot" Color="#FFABCDEF" />
      </StackPanel.Resources>
      <StackPanel.Tag>
        <Border Background="{StaticResource Res.LaterRoot}" />
      </StackPanel.Tag>
    </StackPanel>
    <StackPanel>
      <Border x:Name="MiddleBefore" Background="{StaticResource Res.MiddleRoot}" />
      <StackPanel.Resources>
        <SolidColorBrush x:Key="Res.MiddleRoot" Color="#FFABCDEF" />
      </StackPanel.Resources>
      <Border x:Name="MiddleAfter" Background="{StaticResource Res.MiddleRoot}" />
    </StackPanel>
    <StackPanel>
      <StackPanel.Resources>
        <SolidColorBrush x:Key="Res.StartRoot" Color="#FFABCDEF" />
      </StackPanel.Resources>
      <Border x:Name="StartAfter" Background="{StaticResource Res.StartRoot}" />
    </StackPanel>
  </StackPanel>
</UserControl>
