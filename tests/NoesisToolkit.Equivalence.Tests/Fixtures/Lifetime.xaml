<UserControl
  x:Class="NoesisToolkit.Equivalence.Tests.LifetimeFixture"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="t:LifetimeOwner"
  Width="400"
  Height="300"
>
  <StackPanel x:Name="Panel">
    <ContentControl x:Name="Holder">
      <TextBlock Text="{Binding Title}" />
    </ContentControl>
    <ContentControl x:Name="Slot" Content="{Binding Current}">
      <ContentControl.ContentTemplate>
        <DataTemplate ntk:DataType="t:PlainItem">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <StackPanel x:Name="Editors">
      <TextBox Width="200" Text="{Binding Title}" />
    </StackPanel>
  </StackPanel>
</UserControl>
