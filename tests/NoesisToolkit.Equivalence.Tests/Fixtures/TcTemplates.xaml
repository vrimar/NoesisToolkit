<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
>
  <ControlTemplate x:Key="Loaded" TargetType="{x:Type t:SpikeControl}">
    <Grid>
      <t:TcLoadedControl />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="Built" TargetType="{x:Type t:SpikeControl}">
    <Grid>
      <t:TcBuiltControl />
    </Grid>
  </ControlTemplate>
</ResourceDictionary>
