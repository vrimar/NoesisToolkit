<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Style x:Key="Res.Forward" TargetType="Border" BasedOn="{StaticResource Res.Later}" />
  <TextBlock x:Key="Res.ForwardUse" Background="{StaticResource Res.LaterBrush}" />
  <TextBlock x:Key="Res.ForwardApp" Background="{StaticResource Muted}" />
  <Style x:Key="Res.Later" TargetType="Border">
    <Setter Property="Height" Value="9" />
  </Style>
  <SolidColorBrush x:Key="Res.LaterBrush" Color="#FF123456" />
  <SolidColorBrush x:Key="Muted" Color="#FF00FF00" />
  <TextBlock x:Key="Res.BackwardUse" Background="{StaticResource Res.LaterBrush}" />
</ResourceDictionary>
