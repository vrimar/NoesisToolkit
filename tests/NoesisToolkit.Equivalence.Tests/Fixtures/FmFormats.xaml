<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <DataTemplate x:Key="Formats" ntk:DataType="t:FmModel">
    <StackPanel>
      <TextBlock x:Name="N0" Text="{Binding Big, StringFormat={}{0:N0}}" />
      <TextBlock x:Name="NegativeN0" Text="{Binding Negative, StringFormat={}{0:N0}}" />
      <TextBlock x:Name="F2" Text="{Binding Pi, StringFormat={}{0:F2}}" />
      <TextBlock x:Name="F2Tie" Text="{Binding Tie, StringFormat={}{0:F2}}" />
      <TextBlock x:Name="N0Half" Text="{Binding Half, StringFormat={}{0:N0}}" />
      <TextBlock x:Name="P0" Text="{Binding Quarter, StringFormat={}{0:P0}}" />
      <TextBlock x:Name="Plain" Text="{Binding Ratio, StringFormat={}{0}%}" />
      <TextBlock x:Name="Level" Text="{Binding Name, StringFormat='Level {0}'}" />
      <TextBlock x:Name="LevelMissing" Text="{Binding Missing, StringFormat='Level {0}'}" />
      <TextBlock x:Name="Aligned" Text="{Binding Pi, StringFormat='[{0,8:F2}]'}" />
      <TextBlock x:Name="StageFormat" Text="{Binding Stage, StringFormat={}{0:N0}}" />
      <TextBlock x:Name="WhenFormat" Text="{Binding When, StringFormat={}{0:yyyy}}" />
      <TextBlock x:Name="Joined">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0:N0} / {1:F2}">
            <Binding Path="Big" />
            <Binding Path="Tie" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <TextBlock x:Name="Custom" Text="{Binding Tie, StringFormat={}{0:0.00}}" />
      <TextBlock x:Name="Hex" Text="{Binding Signed, StringFormat={}{0:X}}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Bare" ntk:DataType="t:FmModel">
    <StackPanel>
      <TextBlock x:Name="Bare" Text="{Binding Pi, StringFormat=F2}" />
      <TextBlock x:Name="JoinedBare">
        <TextBlock.Text>
          <MultiBinding StringFormat="N0">
            <Binding Path="Big" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Numbers" ntk:DataType="t:FmModel">
    <StackPanel>
      <TextBlock x:Name="Ratio" Text="{Binding Ratio}" />
      <TextBlock x:Name="Small" Text="{Binding Small}" />
      <TextBlock x:Name="Negative" Text="{Binding Negative}" />
      <TextBlock x:Name="Infinite" Text="{Binding Infinite}" />
      <TextBlock x:Name="NegativeZero" Text="{Binding NegativeZero}" />
      <TextBlock x:Name="Flag" Text="{Binding Flag}" />
      <TextBlock x:Name="Stage" Text="{Binding Stage}" />
      <t:SpikeControl x:Name="Combined" Label="{Binding Combined}" />
      <TextBlock x:Name="Named" Text="{Binding Named}" />
      <TextBlock x:Name="When" Text="{Binding When}" />
      <TextBlock x:Name="Missing" Text="{Binding Missing}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Unlike" ntk:DataType="t:FmModel">
    <StackPanel>
      <TextBlock x:Name="Letter" Text="{Binding Letter}" />
      <TextBlock x:Name="Amount" Text="{Binding Amount}" />
      <TextBlock x:Name="Payload" Text="{Binding Payload}" />
      <TextBlock x:Name="Items" Text="{Binding Items}" />
      <TextBlock x:Name="Unnamed" Text="{Binding Unnamed}" />
    </StackPanel>
  </DataTemplate>

  <ControlTemplate x:Key="Chrome" TargetType="{x:Type t:SpikeControl}">
    <StackPanel>
      <TextBlock x:Name="TemplatedText" Text="{TemplateBinding Count}" />
      <t:SpikeControl x:Name="TemplatedLabel" Label="{TemplateBinding Count}" />
      <TextBlock x:Name="TemplatedTag" Text="{TemplateBinding Tag}" />
      <Border x:Name="TemplatedWidth" Height="5" Width="{TemplateBinding Count}" />
    </StackPanel>
  </ControlTemplate>
</ResourceDictionary>
