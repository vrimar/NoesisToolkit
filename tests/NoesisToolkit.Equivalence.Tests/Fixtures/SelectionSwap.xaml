<UserControl
  x:Class="NoesisToolkit.Equivalence.Tests.SelectionSwapFixture"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="t:SpikeOwner"
  Width="400"
  Height="300"
>
  <ListBox
    x:Name="Picker"
    ItemsSource="{Binding Items}"
    SelectedItem="{Binding Picked, Mode=TwoWay}"
  />
</UserControl>
