<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <ControlTemplate x:Key="Toggle" TargetType="{x:Type ToggleButton}">
    <StackPanel>
      <CheckBox x:Name="Check" IsChecked="{TemplateBinding IsChecked}" />
      <TextBlock x:Name="Number" Text="{TemplateBinding Width}" />
      <Border x:Name="Brushed" Width="5" Height="5" Panel.ZIndex="{TemplateBinding TabIndex}">
        <Border.Background>
          <SolidColorBrush Color="Red" Opacity="{TemplateBinding Opacity}" />
        </Border.Background>
      </Border>
    </StackPanel>
  </ControlTemplate>

  <ControlTemplate x:Key="Managed" TargetType="{x:Type t:SpikeControl}">
    <StackPanel>
      <t:SpikeControl
        x:Name="Inner"
        Label="{TemplateBinding Label}"
        Count="{TemplateBinding Count}"
      />
      <TextBlock x:Name="Inline">
        <Run x:Name="Word" Text="{TemplateBinding Label}" />
      </TextBlock>
      <TextBlock x:Name="Counted" Text="{TemplateBinding Count}" />
    </StackPanel>
  </ControlTemplate>

  <Style x:Key="Styled" TargetType="{x:Type t:SpikeControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <TextBlock x:Name="FromStyle" Text="{TemplateBinding Label}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="Data">
    <TextBlock x:Name="InData" Tag="{TemplateBinding Tag}" />
  </DataTemplate>

  <ItemsPanelTemplate x:Key="Panel">
    <StackPanel x:Name="Stack" Margin="{TemplateBinding Margin}" />
  </ItemsPanelTemplate>
</ResourceDictionary>
