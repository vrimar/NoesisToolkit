<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <ControlTemplate x:Key="PopupChrome" TargetType="t:PaHost">
    <Grid>
      <Popup IsOpen="{TemplateBinding IsOpen}" StaysOpen="True">
        <Border Width="100" Height="80">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </Popup>
    </Grid>
  </ControlTemplate>

  <DataTemplate x:Key="Picker" ntk:DataType="t:PaModel">
    <t:PaHost Template="{StaticResource PopupChrome}" Tag="{Binding Label}" IsOpen="{Binding Open}">
      <StackPanel>
        <TextBlock
          x:Name="Direct"
          Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=t:PaHost}}"
        />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate ntk:DataType="t:PaRow">
              <TextBlock
                Text="{Binding Name}"
                Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=t:PaHost}}"
              />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </t:PaHost>
  </DataTemplate>
</ResourceDictionary>
