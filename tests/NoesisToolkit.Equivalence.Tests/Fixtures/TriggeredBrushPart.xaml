<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:NoesisToolkit.Equivalence.Tests;assembly=NoesisToolkit.Equivalence.Tests"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <ControlTemplate x:Key="BrushPart" TargetType="{x:Type t:SpikeControl}">
    <Border x:Name="Chrome" Width="10" Height="10">
      <Border.Background>
        <ImageBrush x:Name="Fill" Stretch="None" />
      </Border.Background>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="Align" Value="Top">
        <Setter TargetName="Fill" Property="Stretch" Value="Fill" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
