<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Noesis.GUI ships win10-* RIDs the modern SDK no longer probes; nothing here consumes them. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <!-- Only the published binary proves anything: a JIT run keeps every member these tests read. -->
    <PublishAot>true</PublishAot>
    <!-- TUnit's trim findings arrive as one roll-up per package; the toolkit's are project references
         and stay individual errors. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Noesis.GUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="../../src/NoesisToolkit.XamlCompiler/NoesisToolkit.XamlCompiler.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="../../src/NoesisToolkit.Mvvm.Generators/NoesisToolkit.Mvvm.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="../../src/NoesisToolkit.Mvvm/NoesisToolkit.Mvvm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Fixtures/**/*.xaml" />
    <TrimmerRootAssembly Include="Noesis.GUI" />
  </ItemGroup>
</Project>
