<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="clr-namespace:Sample.Roots"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
>
  <Style TargetType="{x:Type r:Picker}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type r:Picker}">
          <StackPanel>
            <ItemsControl
              ItemsSource="{Binding Choices, RelativeSource={RelativeSource TemplatedParent}}"
              DisplayMemberPath="Label"
            />
            <ItemsControl DisplayMemberPath="Label">
              <ItemsControl.ItemsSource>
                <Binding Path="Choices" RelativeSource="{RelativeSource TemplatedParent}" />
              </ItemsControl.ItemsSource>
            </ItemsControl>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Rows" TargetType="ItemsControl">
    <Setter Property="DisplayMemberPath" Value="Name" ntk:ItemType="r:RowViewModel" />
  </Style>
</ResourceDictionary>
