<UserControl
  x:Class="Sample.Roots.InterfaceHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:r="clr-namespace:Sample.Roots"
  xmlns:s="clr-namespace:Sample.Shapes"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:DataType="s:ShapesPanel"
>
  <StackPanel>
    <TextBlock Text="{Binding Selection.Current.Name}" />
    <TextBlock Text="{Binding Labelled.Label}" />
    <TextBlock Text="{Binding Orphan.Label}" />
    <TextBlock r:Hint.Text="{Binding Orphan.Label}" />
    <Border>
      <i:Interaction.Triggers>
        <r:Watcher EventName="Pinged" Source="{Binding Pinger}" />
        <r:Watcher EventName="Silenced" Source="{Binding Mute}" />
      </i:Interaction.Triggers>
    </Border>
  </StackPanel>
</UserControl>
