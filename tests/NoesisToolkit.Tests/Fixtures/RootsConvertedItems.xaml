<UserControl
  x:Class="Sample.Roots.ConvertedItemsHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="clr-namespace:Sample.Roots"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:DataType="r:Library"
>
  <StackPanel>
    <Button Click="OnGo" />
    <ItemsControl>
      <ItemsControl.ItemsSource>
        <Binding Path="Volumes">
          <Binding.Converter>
            <r:Passthrough />
          </Binding.Converter>
        </Binding>
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
