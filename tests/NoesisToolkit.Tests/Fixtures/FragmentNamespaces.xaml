<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:unused="clr-namespace:Sample.Unused"
  xmlns:app="clr-namespace:Sample"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
>
  <Style x:Key="Templated" TargetType="{x:Type app:MyControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border Background="{TemplateBinding Background}" />
            <TextBlock Text="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Bound" TargetType="{x:Type app:MyControl}">
    <Setter Property="Tag" Value="{Binding Name}" />
  </Style>

  <Style x:Key="Spaced" TargetType="{x:Type app:MyControl}" xml:space="preserve">
    <Setter Property="ToolTip" Value="{Binding Spaced}" />
  </Style>

  <GridViewColumn x:Key="Column" mc:Ignorable="d" ntk:ItemType="app:MyControl" DisplayMemberBinding="{Binding Name}" />
</ResourceDictionary>
