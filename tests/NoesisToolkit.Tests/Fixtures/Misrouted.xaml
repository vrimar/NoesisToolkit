<UserControl
  x:Class="Sample.MisroutedHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="ui:ItemViewModel"
>
  <UserControl.Resources>
    <MatrixTransform x:Key="Shifted" Matrix="1,0,0,1,5,5" />
    <Style x:Key="Cached" TargetType="ui:Gutter">
      <Setter Property="VirtualizingPanel.CacheLength" Value="1,2" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <ui:Gutter x:Name="Spaced" Span="10" />
    <TextBlock Text="{Binding ElementName=Spaced, Path=Span}" />
  </StackPanel>
</UserControl>
