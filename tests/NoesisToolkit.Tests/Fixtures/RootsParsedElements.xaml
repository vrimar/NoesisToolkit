<UserControl
  x:Class="Sample.Roots.ParsedElementsHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="clr-namespace:Sample.Roots"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:DataType="r:PanelViewModel"
>
  <UserControl.Resources>
    <r:Upper x:Key="Up" />
  </UserControl.Resources>
  <StackPanel>
    <NativeOnlyPanel Tag="{Binding Inner.Note}" r:Absent.Label="{Binding Headline.Text}" />
    <NativeOnlyPanel Tag="{Binding Missing}" />
    <ListView ItemsSource="{Binding Rows}">
      <ListView.View>
        <GridView>
          <GridViewColumn
            DisplayMemberBinding="{Binding Name}"
            Header="{Binding Lacking, Converter={StaticResource Up}}"
          />
        </GridView>
      </ListView.View>
    </ListView>
  </StackPanel>
</UserControl>
