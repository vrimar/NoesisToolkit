<UserControl
  x:Class="Sample.Roots.NamesHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:n="clr-namespace:Sample.Names"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:DataType="n:NamesPanel"
>
  <StackPanel>
    <TextBlock Text="{Binding Labelled.Label}" />
    <TextBlock Text="{Binding Titled.Title}" />
  </StackPanel>
</UserControl>
