<UserControl
  x:Class="Sample.RepeatedRefusalsHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="ui:ItemViewModel"
>
  <StackPanel>
    <TextBlock Text="{Binding Family, Converter={StaticResource {x:Type ui:Missing}}}" />
    <NativeOnlyPanel>
      <Border Tag="{StaticResource Outside}" Width="{StaticResource Outside}">
        <TextBlock Tag="{StaticResource Outside}" />
      </Border>
    </NativeOnlyPanel>
    <StackPanel.Resources>
      <SolidColorBrush x:Key="Outside" />
    </StackPanel.Resources>
  </StackPanel>
</UserControl>
