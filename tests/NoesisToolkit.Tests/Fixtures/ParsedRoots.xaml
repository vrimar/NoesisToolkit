<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Sample"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <Style x:Key="Heading" TargetType="TextBlock" />
  <TextBlock x:Key="Greeting" Text="{local:Tr Hi}" Style="{StaticResource Heading}" />
  <ControlTemplate x:Key="Chrome" TargetType="Button" ntk:DataType="local:Flagged">
    <Border x:Name="Frame" Tag="{local:Tr Primary}" />
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding Flag}" Value="True">
        <Setter TargetName="Frame" Property="Tag" Value="lit" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
