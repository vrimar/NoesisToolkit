<UserControl
  x:Class="Sample.CompiledHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="ui:ItemViewModel"
>
  <UserControl.Resources>
    <ui:UpConverter x:Key="Up" />
    <ui:JoinConverter x:Key="Join" />
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Go}" />
  </UserControl.InputBindings>

  <StackPanel>
    <TextBlock Text="{Binding Def.Family}" />
    <TextBlock Text="{Binding DefIdInt}" />
    <TextBlock Text="{Binding Def.Family, Mode=TwoWay}" />
    <TextBlock Text="{Binding Nope}" />
    <TextBlock Text="{Binding DefIdInt, Converter={StaticResource Up}}" />
    <TextBlock Width="{Binding Ratio}" />
    <TextBlock Text="{Binding Ratio, StringFormat='x {0:F1} m'}" />
    <TextBlock Height="{Binding Purse}" />
    <TextBlock Tag="{Binding}" />
    <Border CornerRadius="{Binding DefIdInt}" />
    <Image Source="{Binding Def.Family}" />
    <Border>
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Ticked}" Value="True">
              <Setter Property="Width" Value="10" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Ticked}" Value="True" />
                <Condition Binding="{Binding DefIdInt}" Value="3" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Width" Value="20" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Missing}" Value="True">
              <Setter Property="Height" Value="5" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>
    <TextBlock>
      <TextBlock.Text>
        <Binding Path="Def.Family" StringFormat="{}{0} held" />
      </TextBlock.Text>
    </TextBlock>
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding StringFormat="{}{0}/{1}">
          <Binding Path="Def.Family" />
          <Binding Path="DefIdInt" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource Join}">
          <Binding Path="Def.Family" />
          <Binding ElementName="Sibling" Path="Text" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding StringFormat="{}{0}!">
          <Binding Path="Nope" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding>
          <MultiBinding.Converter>
            <ui:JoinConverter />
          </MultiBinding.Converter>
          <Binding Path="Def.Family" />
          <Binding Path="DefIdInt" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
    <CheckBox IsChecked="{Binding Ticked}" />
    <ContentControl>
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <TextBlock Tag="{Binding}" Text="{Binding Family}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <TextBlock>
      <b:Interaction.Behaviors>
        <ui:PokeBehavior Text="{Binding Def.Family}" />
      </b:Interaction.Behaviors>
      <b:Interaction.Triggers>
        <ui:PokeTrigger EventName="Loaded">
          <ui:PokeAction Parameter="{Binding}" />
        </ui:PokeTrigger>
      </b:Interaction.Triggers>
    </TextBlock>

    <TextBlock x:Name="Sibling" />
    <TextBlock x:Name="Outer" DataContext="{Binding Def}" />
    <TextBlock Text="{Binding ElementName=Sibling, Path=DataContext.Family}" />
    <TextBlock Text="{Binding ElementName=Sibling, Path=Text}" />
    <TextBlock Text="{Binding ElementName=Sibling, Path=Name}" />
    <TextBlock Text="{Binding Def.Family, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
    <TextBlock Text="{Binding Def.Family, Mode=OneTime}" />
    <TextBlock Text="{Binding ReadOnlyName, Mode=TwoWay}" />

    <ItemsControl>
      <ItemsControl.ItemTemplate>
        <DataTemplate ntk:DataType="ui:ItemDef">
          <StackPanel>
            <TextBlock x:Name="Peer" />
            <TextBlock Text="{Binding ElementName=Peer, Path=DataContext.Family}" />
            <TextBlock Text="{Binding ElementName=Outer, Path=DataContext.Family}" />
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.Family}" />
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.Family}" />
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Family}" Value="gem">
              <Setter TargetName="Peer" Property="Width" Value="7" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
