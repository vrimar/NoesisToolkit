<UserControl
  x:Class="Sample.GeneratedPropertyHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="ui:ItemViewModel"
>
  <StackPanel>
    <ui:Badge x:Name="Tagged" Label="{Binding Def.Family}" />
    <TextBlock Text="{Binding ElementName=Tagged, Path=Label}" />
  </StackPanel>
</UserControl>
