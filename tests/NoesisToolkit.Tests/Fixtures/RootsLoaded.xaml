<UserControl
  x:Class="Sample.Roots.LoadedHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="clr-namespace:Sample.Roots"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:DataType="r:PanelViewModel"
>
  <StackPanel>
    <Button Click="OnGo" />
    <TextBlock Text="{Binding Headline.Text}" />
    <r:Dial Caption="Literal" />
  </StackPanel>
</UserControl>
