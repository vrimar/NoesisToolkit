<UserControl
  x:Class="Sample.MultiBindingKnobsHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="ui:ItemViewModel"
>
  <StackPanel>
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding Mode="One Way" StringFormat="{}{0}!">
          <Binding Path="Nope" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </StackPanel>
</UserControl>
