<UserControl
  x:Class="Sample.KnobHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
>
  <StackPanel>
    <ui:Knob x:Name="Lead" />
    <ui:Knob Angle="{Binding Angle, ElementName=Lead}" Tilt="{Binding Tilt, ElementName=Lead}" />
  </StackPanel>
</UserControl>
