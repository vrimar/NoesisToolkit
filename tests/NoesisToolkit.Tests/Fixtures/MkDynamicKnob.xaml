<UserControl
  x:Class="Sample.MkKnobHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <StackPanel>
    <TextBlock Text="{Binding Name, ConverterParameter={DynamicResource Knob}}" />
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding FallbackValue="{DynamicResource Knob}">
          <Binding Path="Name" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </StackPanel>
</UserControl>
