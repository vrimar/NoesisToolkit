<UserControl
  x:Class="Sample.NativeSitesHost"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Sample.Ui"
  xmlns:ntk="https://github.com/vrimar/NoesisToolkit"
  ntk:CompileBindings="True"
  ntk:DataType="ui:ItemViewModel"
>
  <UserControl.Resources>
    <ui:UpConverter x:Key="Up" />
    <Style x:Key="Flagged" TargetType="TextBlock">
      <Setter Property="Text" Value="{Binding Family}" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{Binding Def.Family}" />
    <TextBlock Text="{Binding Nope}" />
    <Border>
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Missing}" Value="True">
              <Setter Property="Height" Value="5" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>
    <ListView>
      <ListView.View>
        <GridView>
          <GridViewColumn
            DisplayMemberBinding="{Binding Family}"
            Header="{Binding Family, Converter={StaticResource Up}}"
          />
        </GridView>
      </ListView.View>
    </ListView>
    <TextBlock Text="{Binding Nope, FallbackValue={Binding Family}, TargetNullValue={Binding Family}}" />
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding>
          <MultiBinding.Converter>
            <ui:JoinConverter />
          </MultiBinding.Converter>
          <Binding Path="Nope" FallbackValue="{Binding Family}" />
          <Binding Path="Family" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
    <ListView>
      <ListView.View>
        <GridView>
          <GridViewColumn DisplayMemberBinding="{Binding Family, FallbackValue={Binding Def.Family}}" />
        </GridView>
      </ListView.View>
    </ListView>
    <NativeOnlyPanel Tag="{Binding Ratio}" />
    <TextBlock>
      <TextBlock.Resources>
        <ui:PokeAction x:Key="Act" Parameter="{Binding Family}" />
      </TextBlock.Resources>
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter
            Property="Text"
            Value="{Binding Family, ConverterParameter={StaticResource Act}}"
          />
          <Setter
            Property="Tag"
            Value="{Binding Family, ConverterParameter={StaticResource Act}}"
          />
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</UserControl>
